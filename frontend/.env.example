# Clerk Authentication
# Get your publishable key from https://dashboard.clerk.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Backend API URLs
# Primary: Vultr
EXPO_PUBLIC_API_PRIMARY=https://YOUR_VULTR_URL/api

# Fallback: Render
EXPO_PUBLIC_API_FALLBACK=https://YOUR_RENDER_URL/api

# Public web client used for shared journey links (not the landing website).
EXPO_PUBLIC_WEB_APP_URL=https://path-finder-webapp.vercel.app
